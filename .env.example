# Base URL of the Uyir api-gateway, as reachable from the phone/emulator.
#   Android emulator -> http://10.0.2.2:8080
#   iOS simulator    -> http://localhost:8080
#   Physical device  -> http://<your-PC-LAN-IP>:8080
# The app uses clientId "patient-app" (native): refresh tokens come back in the
# JSON body and are kept in the device's secure store - no cookies, no CORS.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# Google sign-in: the WEB OAuth client ID (same as authservice GOOGLE_CLIENT_ID).
# Works only in a development/release build, not in Expo Go.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
